# OpenWeatherMap API key (free tier)
# Sign up: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# MCP server host/port (optional — defaults shown)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Optional: comma-separated public Hostnames for DNS rebinding protection
# (use on Render if you prefer an allowlist instead of disabling the guard)
# MCP_ALLOWED_HOSTS=weather-mcp-xxxx.onrender.com
